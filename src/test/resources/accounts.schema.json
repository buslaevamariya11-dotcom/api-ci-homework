{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "number",
      "balance",
      "currency"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "number": {
        "type": "string"
      },
      "balance": {
        "type": "integer"
      },
      "currency": {
        "type": "string",
        "enum": [
          "RUB",
          "USD"
        ]
      }
    }
  }
}